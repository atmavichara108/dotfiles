{"name": "qtile reload config", "desc": "перезагрузить конфиг qtile", "cmd": "qtile cmd-obj -o cmd -f reload_config", "hint": "Super+Shift+R", "tags": ["qtile", "wm"], "source": "qtile-keys"}
