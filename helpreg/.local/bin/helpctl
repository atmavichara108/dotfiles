#!/usr/bin/env python3
"""helpctl — единый реестр команд и подсказок (help-registry v1).

Один реестр (JSONL, одна запись = одна строка) + генераторы представления:

  helpctl list [--tag T] [--json]   список записей (для конвейеров)
  helpctl rofi [--tag T]            rofi-меню: выбор запускает cmd; отдельный пункт — добавить
  helpctl add                       форма (rofi) -> валидация -> дозапись ОДНОЙ строки
  helpctl navi [--out DIR]          экспорт cheat-файлов для navi
  helpctl keys                      хоткеи из qtile keys.py рядом с записями (ТОЛЬКО чтение)
  helpctl check                     валидность реестра: JSON, дубликаты name, секреты

Коды возврата: 0 успех, 1 пусто/отмена, 2 ошибка ввода или данных, 3 отказ (дубликат/секрет).

Зависимости: python3 (stdlib), rofi, coreutils. jq/navi — по желанию.
Секретов в реестре быть не может: файл лежит в репозитории.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# --- пути ---------------------------------------------------------------------

_SELF = Path(__file__).resolve()
_REPO_CANDIDATE = _SELF.parent.parent.parent  # <pkg>/.local/bin/helpctl -> <pkg>
_ENV = os.environ

DEFAULT_SOURCE = "manual"
SOURCES = ("manual", "qtile-keys", "imported")
NAVI_SUBDIR = "rudra"
NAVI_PREFIX = "helpreg-"
NAVI_MARKER = "generated by helpctl"
ADD_ENTRY = "➕  добавить команду в реестр"


def registry_path() -> Path:
    """Реестр: env HELPREG_REGISTRY -> ~/.config/help-registry -> пакет в репо."""
    env = _ENV.get("HELPREG_REGISTRY")
    if env:
        return Path(env).expanduser()
    xdg = Path(_ENV.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
    user = xdg / "help-registry" / "registry.jsonl"
    if user.exists():
        return user
    pkg = _REPO_CANDIDATE / ".config" / "help-registry" / "registry.jsonl"
    return pkg if pkg.exists() else user


def keys_py_path() -> Path:
    env = _ENV.get("HELPREG_KEYS")
    if env:
        return Path(env).expanduser()
    for cand in (
        Path.home() / "dotfiles" / "qtile" / ".config" / "qtile" / "keys.py",
        Path(_ENV.get("XDG_CONFIG_HOME") or (Path.home() / ".config")) / "qtile" / "keys.py",
    ):
        if cand.exists():
            return cand
    return Path.home() / ".config" / "qtile" / "keys.py"


def navi_dir_default() -> Path:
    data = Path(_ENV.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
    return data / "navi" / "cheats" / NAVI_SUBDIR


# --- модель записи ------------------------------------------------------------

REQUIRED = ("name", "desc")
FIELDS = ("name", "desc", "cmd", "hint", "tags", "source")

# Секретоподобные признаки. Реестр — публичный (в репозитории), поэтому
# отклоняем не «подозрительное вообще», а конкретные формы секретов.
SECRET_PATTERNS = (
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"(?i)\b(?:password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key|"
    r"private[_-]?key|auth[_-]?token|client[_-]?secret)\b\s*[:=]",
    r"(?i)\bbearer\s+[A-Za-z0-9._~+/-]{16,}",
    r"\bsk-[A-Za-z0-9]{16,}",
    r"\bghp_[A-Za-z0-9]{20,}",
    r"\bgithub_pat_[A-Za-z0-9_]{20,}",
    r"\bAKIA[0-9A-Z]{16}\b",
    r"(?i)\bssh-(?:rsa|ed25519|dss)\s+AAAA[A-Za-z0-9+/]{20,}",
    r"\bAIza[0-9A-Za-z_-]{30,}",
    r"\bxox[baprs]-[A-Za-z0-9-]{10,}",
    r"(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{40,}={0,2}(?![A-Za-z0-9+/])",
)


def record_text(rec: dict) -> str:
    parts = []
    for key in FIELDS:
        val = rec.get(key)
        if isinstance(val, (list, tuple)):
            parts.extend(str(x) for x in val)
        elif val is not None:
            parts.append(str(val))
    return "\n".join(parts)


def secret_hit(rec: dict) -> str | None:
    """Вернуть первый совпавший секретоподобный паттерн, иначе None."""
    text = record_text(rec)
    for pat in SECRET_PATTERNS:
        m = re.search(pat, text)
        if m:
            return m.group(0)[:60]
    return None


class Refused(Exception):
    """Отказ (rc=3): дубликат name или секретоподобная запись."""


class InputError(Exception):
    """Ошибка ввода/данных (rc=2)."""


def normalize(raw: dict, source_default: str = DEFAULT_SOURCE) -> dict:
    if not isinstance(raw, dict):
        raise InputError("запись должна быть объектом JSON")
    rec = {}
    for key in FIELDS:
        rec[key] = raw.get(key, "")
    rec["name"] = str(rec["name"]).strip()
    rec["desc"] = str(rec["desc"]).strip()
    rec["cmd"] = str(rec["cmd"]).strip()
    rec["hint"] = str(rec["hint"]).strip()

    tags = rec["tags"]
    if tags is None or tags == "":
        tags = []
    elif isinstance(tags, str):
        tags = [t.strip() for t in tags.split(",")]
    elif isinstance(tags, (list, tuple)):
        tags = [str(t).strip() for t in tags]
    else:
        raise InputError("tags должны быть списком или строкой через запятую")
    rec["tags"] = [t for t in tags if t]

    src = str(rec["source"]).strip() or source_default
    if src not in SOURCES:
        raise InputError(f"source должен быть одним из {', '.join(SOURCES)}")
    rec["source"] = src

    if not rec["name"]:
        raise InputError("name обязателен")
    if not rec["desc"]:
        raise InputError("desc обязателен")
    return rec


def load_registry(strict: bool = True) -> list[dict]:
    """Прочитать реестр. strict=True — ошибка на битой строке (InputError)."""
    path = registry_path()
    if not path.exists():
        return []
    records: list[dict] = []
    with path.open(encoding="utf-8") as fh:
        for lineno, line in enumerate(fh, 1):
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError as exc:
                if strict:
                    raise InputError(f"{path}:{lineno}: не JSON ({exc.msg})")
                continue
            try:
                records.append(normalize(obj, source_default=str(obj.get("source") or DEFAULT_SOURCE)))
            except InputError as exc:
                if strict:
                    raise InputError(f"{path}:{lineno}: {exc}") from exc
                continue
    return records


def append_record(rec: dict) -> Path:
    """Дозапись РОВНО одной строки (`>>`, без перезаписи файла)."""
    path = registry_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    line = json.dumps(rec, ensure_ascii=False, separators=(", ", ": "))
    with path.open("a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    return path


# --- вывод --------------------------------------------------------------------

def format_line(rec: dict) -> str:
    hint = f"  [{rec['hint']}]" if rec["hint"] else ""
    tags = f"  #{' #'.join(rec['tags'])}" if rec["tags"] else ""
    cmd = f"\n      $ {rec['cmd']}" if rec["cmd"] else ""
    return f"{rec['name']} — {rec['desc']}{hint}{tags}{cmd}"


def rofi_lines(records: list[dict]) -> list[str]:
    lines = [ADD_ENTRY]
    for rec in records:
        hint = f"  [{rec['hint']}]" if rec["hint"] else ""
        lines.append(f"{rec['name']} — {rec['desc']}{hint}")
    return lines


def rofi_run(args: list[str], prompt: str, stdin_text: str = "", mesg: str = "") -> tuple[int, str]:
    cmd = ["rofi", "-dmenu", "-i", "-p", prompt]
    if mesg:
        cmd += ["-mesg", mesg]
    cmd += args
    proc = subprocess.run(cmd, input=stdin_text, capture_output=True, text=True)
    return proc.returncode, proc.stdout.strip()


def have(binary: str) -> bool:
    return shutil.which(binary) is not None


def filter_tag(records: list[dict], tag: str | None) -> list[dict]:
    if not tag:
        return records
    return [r for r in records if tag in r["tags"]]


# --- подкоманда: list ---------------------------------------------------------

def cmd_list(args) -> int:
    records = filter_tag(load_registry(), args.tag)
    if not records:
        print("реестр пуст" if not args.tag else f"нет записей с тегом {args.tag}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(records, ensure_ascii=False, indent=2))
    else:
        for rec in records:
            print(format_line(rec))
    return 0


# --- подкоманда: rofi ---------------------------------------------------------

def cmd_rofi(args) -> int:
    records = filter_tag(load_registry(), args.tag)
    lines = rofi_lines(records)
    if args.print_list:
        print("\n".join(lines))
        return 0
    if not records:
        print("реестр пуст — нечего показывать", file=sys.stderr)
        return 1

    mesg = f"{len(records)} записей · Enter — запустить · Esc — выход"
    if args.select:
        choice = args.select
    else:
        if not have("rofi"):
            print("rofi не найден в PATH", file=sys.stderr)
            return 2
        rc, choice = rofi_run([], "help ▸", "\n".join(lines), mesg)
        if rc != 0 or not choice:
            print("отменено", file=sys.stderr)
            return 1

    if choice.strip() == ADD_ENTRY:
        return cmd_add(argparse.Namespace(
            json=None, name=None, desc=None, cmd=None, hint=None, tags=None,
            source=None, registry=None, interactive=None,
        ))

    rec = None
    for cand in records:
        if choice.strip() == format_line(cand).split("\n")[0] or choice.strip().startswith(cand["name"] + " —"):
            rec = cand
            break
    if rec is None:
        print(f"неизвестный пункт: {choice!r}", file=sys.stderr)
        return 2

    if not rec["cmd"]:
        text = rec["hint"] or rec["desc"]
        print(f"{rec['name']}: команды нет (справочная запись) — {text}")
        return 0

    print(f"$ {rec['cmd']}")
    return subprocess.run(rec["cmd"], shell=True).returncode


# --- подкоманда: add ----------------------------------------------------------

def free_keys_hint(limit: int = 6) -> str:
    """§6: справка по свободным клавишам рядом с формой. Только чтение."""
    bases = [
        Path.home() / "Projects" / "OpenCode-Vault",
        Path.home() / "dotfiles",
    ]
    found: list[str] = []
    for base in bases:
        if not base.exists():
            continue
        for path in base.rglob("*hotkey*audit*.md"):
            try:
                for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                    if re.search(r"(?i)свобод", line) and line.strip().startswith(("-", "*", "|")):
                        found.append(re.sub(r"\s+", " ", line.strip())[:120])
                        break
            except OSError:
                continue
            if found:
                break
        if found:
            break
    if not found:
        return "Свободные клавиши (справка): docs/opencode-hotkeys-audit-2026-10-01.md"
    return "Свободные клавиши (справка): " + " | ".join(found[:limit])


def ask(prompt: str, mesg: str = "") -> str | None:
    if not have("rofi"):
        raise InputError("rofi не найден в PATH — форма недоступна")
    rc, text = rofi_run([], prompt, "", mesg)
    if rc != 0:
        return None
    return text


def form_via_rofi() -> dict | None:
    name = ask("Имя записи (уникальное)")
    if name is None or not name:
        return None
    desc = ask("Описание (человеческое)")
    if desc is None or not desc:
        return None
    cmd = ask("Команда для запуска (можно пусто)")
    if cmd is None:
        return None
    hint = ask("Подсказка по клавишам", free_keys_hint())
    if hint is None:
        return None
    tags = ask("Теги через запятую (напр. qtile,wm)")
    if tags is None:
        return None
    return {"name": name, "desc": desc, "cmd": cmd, "hint": hint,
            "tags": tags, "source": DEFAULT_SOURCE}


def cmd_add(args) -> int:
    if args.registry:
        _ENV["HELPREG_REGISTRY"] = str(Path(args.registry).expanduser())

    raw = None
    if args.json:
        try:
            raw = json.loads(args.json)
        except json.JSONDecodeError as exc:
            print(f"не JSON: {exc.msg}", file=sys.stderr)
            return 2
    elif any([args.name, args.desc, args.cmd, args.hint, args.tags, args.source]):
        raw = {
            "name": args.name or "", "desc": args.desc or "", "cmd": args.cmd or "",
            "hint": args.hint or "", "tags": args.tags or "",
            "source": args.source or DEFAULT_SOURCE,
        }
    else:
        raw = form_via_rofi()
        if raw is None:
            print("отменено", file=sys.stderr)
            return 1

    try:
        rec = normalize(raw, source_default=args.source or DEFAULT_SOURCE)
    except InputError as exc:
        print(f"ошибка ввода: {exc}", file=sys.stderr)
        return 2

    hit = secret_hit(rec)
    if hit:
        print(f"отказ: запись похожа на секрет ({hit!r}) — в реестр не пишем", file=sys.stderr)
        return 3

    try:
        existing = load_registry()
    except InputError as exc:
        print(f"ошибка данных: {exc}", file=sys.stderr)
        return 2
    names = {r["name"] for r in existing}
    if rec["name"] in names:
        print(f"отказ: name уже есть в реестре: {rec['name']}", file=sys.stderr)
        return 3

    path = append_record(rec)
    print(f"добавлено: {rec['name']} -> {path}")
    return 0


# --- подкоманда: navi ---------------------------------------------------------

def cheat_slug(tag: str) -> str:
    return re.sub(r"[^a-z0-9-]+", "-", tag.lower()).strip("-") or "misc"


def cmd_navi(args) -> int:
    records = load_registry()
    if not records:
        print("реестр пуст — нечего экспортировать", file=sys.stderr)
        return 1

    out_dir = Path(args.out).expanduser() if args.out else navi_dir_default()
    out_dir.mkdir(parents=True, exist_ok=True)

    groups: dict[str, list[dict]] = {}
    for rec in records:
        tag = rec["tags"][0] if rec["tags"] else "misc"
        groups.setdefault(tag, []).append(rec)

    written, unchanged, skipped, refused = [], [], [], []
    for tag in sorted(groups):
        body = [f"% {tag}", "", f"# {NAVI_MARKER} — редактируй реестр, не файл", ""]
        for rec in groups[tag]:
            if not rec["cmd"]:
                skipped.append(f"{rec['name']} (нет cmd)")
                continue
            desc = rec["desc"]
            if rec["hint"]:
                desc = f"{desc} [{rec['hint']}]"
            body += [f"# {desc}", rec["cmd"], ""]
        content = "\n".join(body).rstrip() + "\n"

        target = out_dir / f"{NAVI_PREFIX}{cheat_slug(tag)}.cheat"
        if target.exists():
            current = target.read_text(encoding="utf-8", errors="replace")
            if NAVI_MARKER not in current:
                refused.append(str(target))
                continue
            if current == content:
                unchanged.append(target.name)
                continue
        target.write_text(content, encoding="utf-8")
        written.append(target.name)

    print(f"navi: каталог {out_dir}")
    if written:
        print(f"  записано/обновлено ({len(written)}): {', '.join(written)}")
    if unchanged:
        print(f"  без изменений ({len(unchanged)}): {', '.join(unchanged)}")
    if skipped:
        print(f"  пропущено без cmd ({len(skipped)}): {', '.join(skipped)}")
    if refused:
        print(f"  отказ: чужой файл без маркера helpctl ({len(refused)}): {', '.join(refused)}",
              file=sys.stderr)
        return 3
    return 0


# --- подкоманда: keys (ТОЛЬКО ЧТЕНИЕ keys.py) ---------------------------------

MOD_NAMES = {"mod4": "Super", "mod1": "Alt", "control": "Ctrl", "shift": "Shift"}


def _call_spans(text: str, name: str) -> list[tuple[int, int, str]]:
    spans = []
    for m in re.finditer(r"\b" + re.escape(name) + r"\s*\(", text):
        start = m.end() - 1
        depth = 0
        idx = start
        while idx < len(text):
            ch = text[idx]
            if ch in "([{":
                depth += 1
            elif ch in ")]}":
                depth -= 1
                if depth == 0:
                    break
            idx += 1
        spans.append((m.start(), idx, text[start + 1:idx]))
    return spans


def _combo(mods_raw: str, key: str) -> str:
    names = []
    for part in mods_raw.split(","):
        part = part.strip().strip("\"'")
        if not part:
            continue
        names.append(MOD_NAMES.get(part, part))
    names.append(key)
    return "+".join(names)


def _tokens_from_cmd(cmd: str) -> set[str]:
    """Токены команды для сопоставления с keys.py: слова, basename, без расширения."""
    tokens: set[str] = set()
    for word in re.split(r"[\s|;&()]+", cmd):
        word = word.strip("\"'")
        if len(word) < 3 or "=" in word:
            continue
        for candidate in (word, os.path.basename(word)):
            candidate = candidate.strip("\"'").lower()
            if len(candidate) < 3:
                continue
            tokens.add(candidate)
            tokens.add(re.sub(r"\.(sh|py|bash)$", "", candidate))
    return tokens


def _tokens_from_key_body(body: str) -> set[str]:
    tokens = set()
    for m in re.finditer(r"lazy\.spawn(?:f)?\(\s*[fr]?[\"']([^\"']+)[\"']", body):
        tokens |= _tokens_from_cmd(m.group(1))
    for m in re.finditer(r"lazy\.(?:[a-z_]+\.)?([a-zA-Z_]+)\s*\(", body):
        tokens.add(m.group(1).lower())
    for m in re.finditer(r"^\s*([a-z_]+_section)\s*$", body, re.M):
        tokens.add(m.group(1).lower())
    return tokens


def parse_keys(path: Path) -> list[dict]:
    """Разобрать keys.py (ТОЛЬКО чтение). Возвращает [{combo, desc, tokens}]."""
    text = path.read_text(encoding="utf-8", errors="replace")
    chords = _call_spans(text, "KeyChord")
    chord_spans = [(s, e) for s, e, _ in chords]

    def split_key(arg: str) -> tuple[str, str, str] | None:
        """arg -> (combo, desc, body) для текста внутри Key(...)."""
        bracket = re.match(r"\s*\[([^\]]*)\]", arg)
        if not bracket:
            return None
        rest = arg[bracket.end():]
        key_m = re.search(r"[\"']([^\"']+)[\"']", rest)
        if not key_m:
            return None
        body = rest[key_m.end():]
        desc_m = re.search(r"desc\s*=\s*[\"']([^\"']*)[\"']", body)
        return (_combo(bracket.group(1), key_m.group(1)),
                desc_m.group(1) if desc_m else "",
                body)

    entries: list[dict] = []
    # 1) обычные Key(...) — не внутри KeyChord
    for start, end, arg in _call_spans(text, "Key"):
        if any(cs <= start <= ce for cs, ce in chord_spans):
            continue
        parsed = split_key(arg)
        if not parsed:
            continue
        combo, desc, body = parsed
        entries.append({"combo": combo, "desc": desc, "tokens": _tokens_from_key_body(body)})

    # 2) KeyChord: префикс комбо + вложенные Key(...) внутри его аргументов
    for _s, _e, carg in chords:
        head = split_key(carg)
        if not head:
            continue
        chord_combo = head[0]
        for _is, _ie, inner in _call_spans(carg, "Key"):
            parsed = split_key(inner)
            if not parsed:
                continue
            combo, desc, body = parsed
            entries.append({"combo": f"{chord_combo} → {combo}", "desc": desc,
                            "tokens": _tokens_from_key_body(body)})
    return entries


def cmd_keys(args) -> int:
    path = Path(args.file).expanduser() if args.file else keys_py_path()
    if not path.exists():
        print(f"keys.py не найден: {path}", file=sys.stderr)
        return 2
    entries = parse_keys(path)
    if not entries:
        print(f"в {path} не найдено привязок Key(...)", file=sys.stderr)
        return 1

    records = load_registry()
    print(f"keys.py: {path} (только чтение, {len(entries)} привязок)")
    if not records:
        print("реестр пуст — сопоставлять нечего")
        return 1

    matched = 0
    for rec in records:
        rec_tokens = _tokens_from_cmd(rec["cmd"]) if rec["cmd"] else set()
        rec_tokens |= {rec["name"].lower()}
        hits = [e for e in entries if rec_tokens & e["tokens"]]
        if not hits:
            if args.all:
                print(f"\n{rec['name']} — ключей не найдено"
                      + (f" (hint: {rec['hint']})" if rec["hint"] else ""))
            continue
        matched += 1
        print(f"\n{rec['name']} — {rec['desc']}")
        if rec["cmd"]:
            print(f"  cmd:  {rec['cmd']}")
        if rec["hint"]:
            print(f"  hint: {rec['hint']}")
        for e in hits:
            suffix = f" — {e['desc']}" if e["desc"] else ""
            print(f"  ключ: {e['combo']}{suffix}")

    print(f"\nсопоставлено: {matched} из {len(records)} записей")
    return 0 if matched else 1


# --- подкоманда: check --------------------------------------------------------

def cmd_check(args) -> int:
    path = registry_path()
    if not path.exists():
        print(f"реестр отсутствует: {path}", file=sys.stderr)
        return 1

    errors: list[str] = []
    warnings: list[str] = []
    names: dict[str, int] = {}
    count = 0
    with path.open(encoding="utf-8") as fh:
        for lineno, line in enumerate(fh, 1):
            if not line.strip():
                warnings.append(f"строка {lineno}: пустая строка")
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError as exc:
                errors.append(f"строка {lineno}: не JSON ({exc.msg})")
                continue
            try:
                rec = normalize(obj, source_default=str(obj.get("source") or DEFAULT_SOURCE))
            except InputError as exc:
                errors.append(f"строка {lineno}: {exc}")
                continue
            hit = secret_hit(rec)
            if hit:
                errors.append(f"строка {lineno}: секретоподобное ({hit!r})")
            names[rec["name"]] = names.get(rec["name"], 0) + 1
            count += 1

    for name, times in names.items():
        if times > 1:
            errors.append(f"дубликат name ({times}x): {name}")

    print(f"check: {path}")
    print(f"  записей: {count}")
    if warnings:
        print(f"  предупреждений: {len(warnings)}")
        for w in warnings[:5]:
            print(f"    - {w}")
    if errors:
        print(f"  ошибок: {len(errors)}", file=sys.stderr)
        for e in errors:
            print(f"    ✗ {e}", file=sys.stderr)
        return 2
    if count == 0:
        print("  реестр пуст", file=sys.stderr)
        return 1
    print("  ✓ реестр валиден: JSON-строки, name уникальны, секретов нет")
    return 0


# --- CLI ----------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="helpctl",
        description="help-registry: один реестр команд/подсказок + rofi/navi генераторы",
    )
    sub = p.add_subparsers(dest="command")

    pl = sub.add_parser("list", help="список записей")
    pl.add_argument("--tag", help="фильтр по тегу")
    pl.add_argument("--json", action="store_true", help="вывод валидным JSON")
    pl.set_defaults(func=cmd_list)

    pr = sub.add_parser("rofi", help="rofi-меню")
    pr.add_argument("--tag", help="фильтр по тегу")
    pr.add_argument("--print-list", action="store_true",
                    help="не открывать rofi, напечатать строки dmenu-списка")
    pr.add_argument("--select", help="без GUI: выбрать пункт по строке/имени (для тестов)")
    pr.set_defaults(func=cmd_rofi)

    pa = sub.add_parser("add", help="добавить запись (rofi-форма или флаги)")
    pa.add_argument("--json", help="запись целиком одним JSON-объектом")
    pa.add_argument("--name")
    pa.add_argument("--desc")
    pa.add_argument("--cmd")
    pa.add_argument("--hint")
    pa.add_argument("--tags", help="теги через запятую")
    pa.add_argument("--source", choices=SOURCES)
    pa.add_argument("--registry", help="путь к реестру (по умолчанию ~/.config/help-registry)")
    pa.set_defaults(func=cmd_add)

    pn = sub.add_parser("navi", help="экспорт cheat-файлов для navi")
    pn.add_argument("--out", help="каталог cheats (по умолчанию ~/.local/share/navi/cheats/rudra)")
    pn.set_defaults(func=cmd_navi)

    pk = sub.add_parser("keys", help="хоткеи из qtile keys.py (только чтение)")
    pk.add_argument("--file", help="путь к keys.py")
    pk.add_argument("--all", action="store_true", help="показать и записи без совпадений")
    pk.set_defaults(func=cmd_keys)

    pc = sub.add_parser("check", help="валидность реестра")
    pc.set_defaults(func=cmd_check)
    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    try:
        return int(args.func(args) or 0)
    except Refused as exc:
        print(f"отказ: {exc}", file=sys.stderr)
        return 3
    except InputError as exc:
        print(f"ошибка ввода: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("прервано", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
