#!/usr/bin/env bash

# ============================================================
# Qtile X11 Autostart
# ============================================================

# --- Desktop Environment (для xdg-desktop-portal) ---
export XDG_CURRENT_DESKTOP=qtile
systemctl --user import-environment XDG_CURRENT_DESKTOP
systemctl --user --no-block start graphical-session.target
systemctl --user --no-block start xdg-desktop-portal xdg-desktop-portal-gtk

# --- Монитор ---
~/.local/bin/monitor-setup &

# --- Композитор ---
picom --daemon

# --- Обои + палитра ---
sleep 1 && wal-set &

# --- Уведомления (ДО flameshot) ---
dunst &

# --- Трей-апплеты ---
nm-applet &

# --- Скриншоты (после dunst + portal) ---
sleep 0.5 && flameshot &

# --- Курсор ---
xsetroot -cursor_name left_ptr &

# --- Раскладка клавиатуры (us/ru, переключение alt+shift) ---
setxkbmap -layout us,ru -option grp:alt_shift_toggle &

# --- Буфер обмена ---
copyq &

# --- Скринлок после бездействия ---
xss-lock -- /usr/local/bin/lock.sh &
