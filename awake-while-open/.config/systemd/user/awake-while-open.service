# awake-while-open: крышка ноутбука не влияет на сон НИКАК (открыта/закрыта — ноут работает).
# Эволюция 2026-10-17 (слово владельца): «при закрытии крышки ничего не происходило и ноут работал так же».
# Ингибитор handle-lid-switch:idle (block): lid-события logind игнорирует; ручной сон (systemctl suspend/кнопка) свободен.
# Дедлайн 24ч снят — фича постоянная. Вернуть штатное: systemctl --user disable --now awake-while-open.
[Unit]
Description=Крышка не влияет на сон: ноут работает всегда (владелец 2026-10-17)

[Service]
; запуск через bash — исполняемый бит не требуется (chmod запрещён агентскому контуру)
ExecStart=/usr/bin/env bash %h/.local/bin/awake-while-open.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
