# ============================================================
# DUNST — Floating notifications / 4K@192dpi
# ============================================================
# Цвета нейтральные — будут заменены во второй волне.
# ============================================================

[global]
    # --- Geometry & Position ---
    width = (300, 600)
    height = (0, 400)
    origin = top-right
    offset = (30, 80)
    notification_limit = 5
    indicate_hidden = yes

    # --- Appearance ---
    font = JetBrainsMono Nerd Font 12
    frame_width = 2
    frame_color = "#3d59a1"
    corner_radius = 14
    separator_height = 2
    separator_color = frame
    padding = 16
    horizontal_padding = 20
    text_icon_padding = 16
    gap_size = 8

    # --- Content ---
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    markup = full
    word_wrap = yes
    show_age_threshold = 60
    icon_position = left
    min_icon_size = 48
    max_icon_size = 48
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true

    # --- Behavior ---
    sort = yes
    idle_threshold = 120
    show_indicators = yes
    sticky_history = yes
    history_length = 30
    follow = mouse
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = context

    # --- Progress bar ---
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 300
    progress_bar_max_width = 500
    progress_bar_corner_radius = 5

    # --- Browser ---
    browser = google-chrome-stable
    dmenu = rofi -dmenu

[urgency_low]
    background = "#1a1b26cc"
    foreground = "#565f89"
    frame_color = "#3d59a1"
    timeout = 5

[urgency_normal]
    background = "#1a1b26cc"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 8

[urgency_critical]
    background = "#1a1b26cc"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
