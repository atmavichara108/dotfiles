{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "lsp": true,
  "model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "allow",
      "pacman -Q*": "allow",
      "pacman -Qi*": "allow",
      "pacman -Qm*": "allow",
      "pacman -Qe*": "allow",
      "which*": "allow",
      "systemctl status*": "allow",
      "stow -n*": "allow",
      "stow --adopt -n*": "allow",
      "uname*": "allow",
      "hostnamectl*": "allow",
      "df*": "allow",
      "free*": "allow",
      "ps*": "allow",
      "echo*": "allow",
      "rm*": "deny",
      "sudo*": "deny",
      "pacman -S*": "deny",
      "pacman -R*": "deny",
      "yay*": "deny",
      "paru*": "deny",
      "systemctl start*": "deny",
      "systemctl stop*": "deny",
      "systemctl restart*": "deny",
      "systemctl enable*": "deny",
      "systemctl disable*": "deny",
      "chmod*": "deny",
      "chown*": "deny",
      "mkfs*": "deny",
      "mount*": "deny",
      "umount*": "deny"
    },
    "external_directory": "allow",
    "webfetch": "allow"
  },
  "agent": {
    "sysop": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "find*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "pacman -Q*": "allow",
          "pacman -Qi*": "allow",
          "pacman -Qm*": "allow",
          "pacman -Qe*": "allow",
          "which*": "allow",
          "systemctl status*": "allow",
          "stow -n*": "allow",
          "uname*": "allow",
          "hostnamectl*": "allow",
          "df*": "allow",
          "free*": "allow",
          "ps*": "allow",
          "echo*": "allow",
          "du -sh*": "allow",
          "lsblk*": "allow",
          "ip addr*": "allow",
          "ss -tlnp*": "allow"
        }
      }
    },
    "planner": {
      "mode": "primary",
      "model": "opencode/claude-haiku-4-5",
      "temperature": 0.2,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": { "*": "allow" }
      }
    },
    "builder": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-plus",
      "temperature": 0.1,
      "steps": 30,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "task": { "reviewer": "allow" }
      }
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "grep*": "allow",
          "cat*": "allow",
          "ls*": "allow",
          "stow -n*": "allow"
        }
      }
    },
    "qtile-dev": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "find*": "allow",
          "git diff*": "allow",
          "python -c*": "allow",
          "python -m py_compile*": "allow",
          "stow -n qtile": "allow"
        }
      }
    },
    "bash-dev": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "find*": "allow",
          "git diff*": "allow",
          "bash -n*": "allow",
          "shellcheck*": "allow",
          "stow -n*": "allow",
          "chmod +x*": "allow"
        }
      }
    },
    "util-dev": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "find*": "allow",
          "git diff*": "allow",
          "stow -n*": "allow",
          "dunstify*": "allow",
          "notify-send*": "allow",
          "python3 -m py_compile*": "allow",
          "python -m py_compile*": "allow",
          "systemctl --user status*": "allow",
          "journalctl --user*": "allow"
        }
      }
    },
    "stow-ops": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "temperature": 0.1,
      "steps": 25,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "find*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "mkdir*": "allow",
          "cp*": "allow",
          "mv*": "allow",
          "ln*": "allow",
          "stow*": "allow",
          "chmod +x*": "allow",
          "touch*": "allow",
          "echo*": "allow",
          "which*": "allow"
        }
      }
    },
    "verifier": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "steps": 15,
      "description": "Верификатор: проверяет синтаксис, статус сервисов, логи, stow dry-run",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "find*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "python3 -m py_compile*": "allow",
          "python -m py_compile*": "allow",
          "systemctl --user status*": "allow",
          "systemctl --user restart*": "allow",
          "systemctl --user start*": "allow",
          "systemctl --user stop*": "allow",
          "journalctl --user*": "allow",
          "stow -n*": "allow",
          "stow --adopt -n*": "allow",
          "chmod +x*": "allow",
          "which*": "allow",
          "ps*": "allow",
          "echo*": "allow"
        }
      }
    }
  }
}
