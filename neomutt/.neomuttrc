# ~/.neomuttrc — mail-hub клиент (ИЦ, 2026-10-30)
# Приём: Maildir ~/Mail/re-search.wiki (mbsync из Gmail через Namecheap EF).
# Отправка: через msmtp (~/.msmtprc, Resend, from rudra108@re-search.wiki).
# Секретов здесь нет и не будет: пароли — в ~/.secrets/mail-hub (600, вне репо).

set from = "rudra108@re-search.wiki"
set realname = "Max Rudra"

# --- почтовые ящики (Maildir) ---
set mbox_type = maildir
set folder = "~/Mail/re-search.wiki"
set spoolfile = "+INBOX"
set postponed = "+INBOX"
set record = "+INBOX"
mailboxes "+INBOX" "+[Gmail]/Вся почта" "+[Gmail]/Отправленные" "+Genspark"

# --- отправка через внешний msmtp (конфиг msmtprc с Resend) ---
set sendmail = "/usr/bin/msmtp"
set use_from = yes
set envelope_from = yes

# --- вид и поведение ---
set index_format = "%2C %zs %-20.20L %-30.30F %s"
set pager_index_lines = 12
set sort = reverse-date
set markers = no
set pager_stop = yes
set editor = "nvim +'set ft=mail spelllang=ru'"

# Клавиши по умолчанию: q — выход, Enter — чтение, r — ответ, m — новое письмо.
