[Unit]
Description=portal-tg-guard — постоянный push-сторож Капитанского портала (TG-чат: журнал меты-only + wake ЦУ только от владельца)
# Граница: зов координатора (ЦУ) — ТОЛЬКО на сообщения владельца (TG_OWNER);
# чужие пишутся в журнал без зова. fail-open: событие остаётся в журнале.
After=network-online.target opencode-serve.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/dotfiles/scripts/.local/bin/portal-tg-guard.py --topic 0
Environment=TG_WAKE_SESSION_ID=ses_eceb23a71ffeJO9QnFou8VngZC
Environment=TG_WAKE_SESSION_TITLE=
Environment=TG_OWN=AllIsMaya
Environment=TG_OWNER=Atma_Vichara108
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
