[Unit]
Description=captain-panel-bot — бот-пульт капитана (Капитанский портал; голос Корабля — Maya, бот — пульт)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/dotfiles/scripts/.local/bin/captain-panel-bot.py
Environment=CAPTAIN_PANEL_PROFILE=captain-panel
Environment=HTTP_PROXY=http://127.0.0.1:10809
Environment=HTTPS_PROXY=http://127.0.0.1:10809
Environment=ALL_PROXY=
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
