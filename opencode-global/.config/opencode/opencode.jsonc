{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3-flash",
  "agent": {
    "general": { "model": "anymodel/cx/gpt-5.6-sol" },
    "build": { "model": "anymodel/cx/gpt-6-luna" },
    "explore": { "model": "anymodel/am/nemotron-3-ultra-550b-a55b" },
    "plan": { "model": "anymodel/cx/gpt-6-luna" }
  },
  "agents": {
    "general": { "model": "anymodel/cx/gpt-5.6-sol" },
    "build": { "model": "anymodel/cx/gpt-6-luna" },
    "explore": { "model": "anymodel/am/nemotron-3-ultra-550b-a55b" },
    "plan": { "model": "anymodel/cx/gpt-6-luna" }
  },
  "permission": {
    "task": "allow",
    "edit": {
      "*": "allow",
      "**/TASKS.md": "ask",
      "**/00-INDEX.md": "ask",
      "**/active-context.md": "ask",
      "**/registry.json": "ask",
      "**/AGENTS.md": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "doom_loop": "deny",
    "external_directory": {
      "*": "deny",
      "/home/rudra/Projects/**": "allow",
      "/home/rudra/dotfiles/**": "allow",
      "**/.env*": "deny",
      "**/credentials.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "chown *": "deny",
      "chmod *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "systemctl stop*": "deny",
      "systemctl disable*": "deny",
      "systemctl mask*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git branch -D*": "deny",
      "git tag -d*": "deny",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm*": "ask",
      "ssh*": "ask"
    }
  },
  "permissions": [
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "**/TASKS.md", "effect": "ask" },
    { "action": "edit", "resource": "**/00-INDEX.md", "effect": "ask" },
    { "action": "edit", "resource": "**/active-context.md", "effect": "ask" },
    { "action": "edit", "resource": "**/registry.json", "effect": "ask" },
    { "action": "edit", "resource": "**/AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "doom_loop", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "**/.env*", "effect": "deny" },
    { "action": "external_directory", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "external_directory", "resource": "**/*.pem", "effect": "deny" },
    { "action": "external_directory", "resource": "**/*.key", "effect": "deny" },
    { "action": "external_directory", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "external_directory", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/rudra/Projects/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/rudra/dotfiles/**", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "systemctl stop*", "effect": "deny" },
    { "action": "shell", "resource": "systemctl disable*", "effect": "deny" },
    { "action": "shell", "resource": "systemctl mask*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr*", "effect": "deny" },
    { "action": "shell", "resource": "rm*", "effect": "ask" },
    { "action": "shell", "resource": "ssh*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" }
  ],
  "provider": {
    // NOTE 2026-09-29: баланс linaliapi исчерпан, агенты переведены на free-модели; блок оставлен — оживёт пополнением.
    "linaliapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LinaliAPI",
      "options": { "baseURL": "https://api.linaliapi.com/v1" },
      "models": {
        "anthropic/claude-opus-5": { "name": "Claude Opus 5", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "openai/gpt-5.6-sol": { "name": "GPT-5.6 Sol", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "openai/gpt-5.6-luna": { "name": "GPT-5.6 Luna", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
