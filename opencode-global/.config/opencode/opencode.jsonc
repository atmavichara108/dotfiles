        "deepseek/deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true }
      }
    },
    "amd-radeon": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AMD Radeon Cloud",
      "options": { "baseURL": "https://developer.amd.com.cn/radeon/api/v1" },
      "models": {
        "DeepSeek-V4-Flash": { "name": "DeepSeek V4 Flash", "attachment": false, "reasoning": false, "tool_call": true, "temperature": true },
        "Qwen3.8-Flash-Next": { "name": "Qwen 3.8 Flash Next (Vision)", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
