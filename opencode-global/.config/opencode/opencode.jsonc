        "DeepSeek-V4-Flash-Vision-Exp": { "name": "DeepSeek V4 Flash Vision (Exp)", "attachment": true, "reasoning": false, "tool_call": true, "temperature": true },
        "GLM-5.3-Flash": { "name": "GLM 5.3 Flash (256K)", "attachment": false, "reasoning": true, "tool_call": true, "temperature": true },
        "Qwen3.8-27B": { "name": "Qwen 3.8 27B (Vision, 256K)", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true }
      }
    },
    "anymodel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AnyModel",
      "options": { "baseURL": "https://anymodel.org/v1" },
      "models": {
        "am/free": { "name": "Free Auto-Router", "attachment": false, "reasoning": false, "tool_call": false, "temperature": false },
        "am/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra (Free)", "attachment": false, "reasoning": true, "tool_call": false, "temperature": true },
        "cc/claude-opus-5": { "name": "Claude Opus 5", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "cx/gpt-6-astra": { "name": "GPT-6 Astra", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "cx/gpt-6-luna": { "name": "GPT-6 Luna", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "cx/gpt-6-sol": { "name": "GPT-6 Sol", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "cx/gpt-5.6-sol": { "name": "GPT-5.6 Sol", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "cc/claude-sonnet-5": { "name": "Claude Sonnet 5", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true },
        "kmc/k3": { "name": "Kimi K3", "attachment": true, "reasoning": true, "tool_call": true, "temperature": true }
      }
    },
    "apinex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Apinex",
      "options": {
        "baseURL": "https://apinex.bond/v1"
      },
      "models": {
        "free/claude-opus-4.6": {
          "name": "Claude Opus 4.6 (Free)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true
