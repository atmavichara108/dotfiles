#!/usr/bin/env python3
"""stale-check — протухшие handshake (>24ч) и старые task-ветки (>7д).

Заменяет суждение кодом: правило TTL/stale из ADR-014 в детерминированной
форме. Exit 0 — всё живо, 1 — есть протухшее.
"""

import subprocess
import sys
import time
from pathlib import Path

DOTFILES = Path.home() / "dotfiles"
HANDSHAKE_DIR = DOTFILES / ".opencode/memory/session-reports/active"
HANDSHAKE_TTL_HOURS = 24
BRANCH_STALE_DAYS = 7


def run(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def main():
    stale = []
    now = time.time()

    try:
        files = [p for p in HANDSHAKE_DIR.iterdir()
                 if p.is_file() and p.name != "_template.md"]
    except Exception:
        files = []
    for p in files:
        age_h = (now - p.stat().st_mtime) / 3600
        if age_h > HANDSHAKE_TTL_HOURS:
            stale.append(f"handshake STALE: {p.name} ({age_h:.1f}h)")

    refs = run(["git", "-C", str(DOTFILES), "for-each-ref",
                "--sort=-committerdate",
                "--format=%(refname:short)|%(committerdate:unix)",
                "refs/heads/", "refs/remotes/"])
    seen = set()
    if refs:
        for line in refs.splitlines():
            if "|" not in line:
                continue
            name, ts = line.rsplit("|", 1)
            short = name.split("/", 1)[-1] if "/" in name else name
            if short in ("main", "master", "HEAD") or short in seen:
                continue
            seen.add(short)
            try:
                age_d = (now - int(ts)) / 86400
            except ValueError:
                continue
            if age_d > BRANCH_STALE_DAYS:
                stale.append(f"branch STALE: {name} ({age_d:.1f}d)")

    if stale:
        print("STALE:")
        for s in stale:
            print(f"  {s}")
        return 1
    print("fresh: no stale handshakes or branches")
    return 0


if __name__ == "__main__":
    sys.exit(main())
