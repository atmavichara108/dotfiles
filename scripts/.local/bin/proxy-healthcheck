#!/bin/bash
# proxy-healthcheck — авто-переключение прокси на основе порта Happ
# Запускается из systemd-таймера. Без циклов, тихий режим.
#
# Логика:
#   - Читает mode из ~/.config/proxyctl/mode (по умолч. auto)
#   - Если mode != auto → skip (оверрайд не сбиваем)
#   - Если auto: порт 10808 активен → proxyctl happ, иначе → proxyctl tor

set -euo pipefail

PROXYCTL="${HOME}/.local/bin/proxyctl"
MODE_FILE="${HOME}/.config/proxyctl/mode"

if [ ! -x "$PROXYCTL" ]; then
    echo "proxy-healthcheck: proxyctl не найден по пути ${PROXYCTL}" >&2
    exit 1
fi

# ── port check helper ─────────────────────────────────────

port_open() {
    local port="$1"
    # Используем curl с SOCKS5 — надёжнее, чем /dev/tcp
    # Таймаут 2 секунды, проверяем только соединение (не загрузку)
    if curl --socks5-hostname "127.0.0.1:${port}" --max-time 2 --connect-timeout 2 \
            -s -o /dev/null -w "%{http_code}" "http://example.com" 2>/dev/null | grep -qE '^[2345]'; then
        return 0
    fi
    # Fallback: проверяем через ss (не требует root для локальных портов)
    if ss -tln 2>/dev/null | grep -q ":${port} "; then
        return 0
    fi
    return 1
}

# ── читаем mode ──────────────────────────────────────────
mode="auto"
if [ -f "$MODE_FILE" ]; then
    mode="$(cat "$MODE_FILE")"
fi

if [ "$mode" != "auto" ]; then
    echo "proxy-healthcheck: mode=${mode}; skip"
    exit 0
fi

# ── auto: детект и переключение ───────────────────────────
if port_open 10808; then
    "$PROXYCTL" happ >/dev/null
else
    "$PROXYCTL" tor >/dev/null
fi
