#!/bin/bash
# proxy-healthcheck — авто-переключение прокси на основе порта Happ
# Запускается из systemd-таймера. Без циклов, тихий режим.
#
# Логика:
#   - Читает mode из ~/.config/proxyctl/mode (по умолч. auto)
#   - Если mode != auto → skip (оверрайд не сбиваем)
#   - Если auto: порт 10812 активен → proxyctl happ, иначе → proxyctl tor

set -euo pipefail

PROXYCTL="${HOME}/.local/bin/proxyctl"
MODE_FILE="${HOME}/.config/proxyctl/mode"

if [ ! -x "$PROXYCTL" ]; then
    echo "proxy-healthcheck: proxyctl не найден по пути ${PROXYCTL}" >&2
    exit 1
fi

# ── port check helper ─────────────────────────────────────

port_open() {
    local port="$1"
    if command -v nc &>/dev/null; then
        nc -z 127.0.0.1 "$port" 2>/dev/null
        return $?
    fi
    # fallback: bash /dev/tcp (built-in, без доп. пакетов)
    timeout 1 bash -c "echo > /dev/tcp/127.0.0.1/${port}" 2>/dev/null
}

# ── читаем mode ──────────────────────────────────────────
mode="auto"
if [ -f "$MODE_FILE" ]; then
    mode="$(cat "$MODE_FILE")"
fi

if [ "$mode" != "auto" ]; then
    echo "proxy-healthcheck: mode=${mode}; skip"
    exit 0
fi

# ── auto: детект и переключение ───────────────────────────
if port_open 10812; then
    "$PROXYCTL" happ >/dev/null
else
    "$PROXYCTL" tor >/dev/null
fi
