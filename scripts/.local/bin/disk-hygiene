#!/usr/bin/env bash
set -euo pipefail

readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly RED='\033[0;31m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*"; }

show_df() {
    echo ""
    info "Свободное место на /:"
    df -h / | grep -v '^Filesystem' || df -h /
    echo ""
}

size_of() {
    if [[ -d "$1" ]]; then
        du -sh "$1" 2>/dev/null | cut -f1
    else
        echo "0"
    fi
}

clean_dir() {
    local dir="$1"
    local label="$2"
    if [[ -d "$dir" ]]; then
        local before
        before=$(size_of "$dir")
        info "Чищу $label ($dir) — было: $before"
        find "$dir" -type f -delete 2>/dev/null || true
        find "$dir" -mindepth 1 -type d -empty -delete 2>/dev/null || true
        local after
        after=$(size_of "$dir")
        ok "  → стало: $after"
    fi
}

clean_cmd() {
    local cmd="$1"
    local label="$2"
    if command -v "$cmd" &>/dev/null; then
        info "Чищу $label через '$cmd'"
        eval "$cmd" 2>/dev/null && ok "  → готово" || warn "  → не удалось"
    fi
}

main() {
    echo "============================================"
    echo "  disk-hygiene — безопасная чистка кэшей"
    echo "============================================"

    show_df
    local df_before
    df_before=$(df / | awk 'NR==2{print $4}')

    info "Размеры кэшей ДО чистки:"
    echo "--------------------------------------------"
    local targets=(
        "$HOME/.cache/yay"
        "$HOME/.cache/paru"
        "$HOME/.cache/go-build"
        "$HOME/.cache/pip"
        "$HOME/.cache/uv"
        "$HOME/.cache/pnpm"
        "$HOME/.cache/node-gyp"
        "$HOME/.cache/thumbnails"
        "$HOME/.cache/chromium"
        "$HOME/.cache/google-chrome"
        "$HOME/.cache/mozilla"
        "$HOME/.cache/electron"
        "$HOME/.cache/nvim"
        "$HOME/.cache/QGIS"
        "$HOME/.cache/mesa_shader_cache"
        "$HOME/.cache/mesa_shader_cache_db"
    )
    for t in "${targets[@]}"; do
        if [[ -d "$t" ]]; then
            printf "  %-50s %s\n" "$t" "$(size_of "$t")"
        fi
    done
    echo "--------------------------------------------"
    echo ""

    info "=== Чистка кэшей AUR-хелперов ==="
    clean_dir "$HOME/.cache/yay" "yay build cache"
    clean_dir "$HOME/.cache/paru" "paru build cache"

    info "=== Чистка go build cache ==="
    if command -v go &>/dev/null; then
        go clean -cache 2>/dev/null && ok "go clean -cache" || warn "go clean -cache failed"
    else
        clean_dir "$HOME/.cache/go-build" "go-build cache (no go binary)"
    fi

    info "=== Чистка pip cache ==="
    clean_cmd "pip cache purge" "pip cache"
    if [[ -d "$HOME/.cache/pip" ]]; then
        clean_dir "$HOME/.cache/pip" "pip cache dir"
    fi

    info "=== Чистка uv cache ==="
    if command -v uv &>/dev/null; then
        uv cache clean 2>/dev/null && ok "uv cache clean" || warn "uv cache clean failed"
    fi
    clean_dir "$HOME/.cache/uv" "uv cache dir"

    info "=== Чистка pnpm store ==="
    if command -v pnpm &>/dev/null; then
        pnpm store prune 2>/dev/null && ok "pnpm store prune" || warn "pnpm store prune failed"
    fi

    info "=== Чистка node-gyp cache ==="
    clean_dir "$HOME/.cache/node-gyp" "node-gyp cache"

    info "=== Чистка thumbnails ==="
    clean_dir "$HOME/.cache/thumbnails" "thumbnails"

    info "=== Чистка npm cache ==="
    if command -v npm &>/dev/null; then
        npm cache clean --force 2>/dev/null && ok "npm cache clean" || warn "npm cache clean failed"
    fi

    echo ""
    show_df
    local df_after
    df_after=$(df / | awk 'NR==2{print $4}')
    local freed=$(( df_after - df_before ))
    ok "Освобождено в $HOME: ${freed}K (~$(( freed / 1024 ))M)"

    echo ""
    echo "============================================"
    echo -e "  ${YELLOW}Требуют sudo — запусти вручную:${NC}"
    echo "============================================"
    echo ""
    echo "  # Оставить 2 версии каждого пакета в кэше pacman:"
    echo "  sudo paccache -rk2"
    echo ""
    echo "  # Удалить кэш удалённых пакетов:"
    echo "  sudo paccache -ruk0"
    echo ""
    echo "  # Журналы старше 7 дней:"
    echo "  sudo journalctl --vacuum-time=7d"
    echo ""
    echo "  # (опционально) Docker, если есть:"
    echo "  docker system prune -af --volumes"
    echo ""
}

main "$@"
