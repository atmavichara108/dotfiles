#!/usr/bin/env bash
set -uo pipefail

readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly RED='\033[0;31m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*"; }

trap 'err "Сбой на строке $LINENO (exit $?)"; exit 1' ERR

AGGRESSIVE=0
for arg in "$@"; do
    case "$arg" in
        --aggressive) AGGRESSIVE=1 ;;
        --help|-h)
            echo "Usage: disk-hygiene [--aggressive]"
            echo "  --aggressive  также чистить кэши браузеров (chromium, chrome, mozilla, electron)"
            exit 0
            ;;
    esac
done

show_df() {
    echo ""
    info "Свободное место:"
    df -h / | grep -v '^Filesystem' || df -h /
    if mountpoint -q "$HOME" 2>/dev/null; then
        df -h "$HOME" | grep -v '^Filesystem' || true
    fi
    echo ""
}

size_of() {
    if [[ -d "$1" ]]; then
        du -sh "$1" 2>/dev/null | cut -f1
    else
        echo "0"
    fi
}

size_bytes() {
    if [[ -d "$1" ]]; then
        du -sb "$1" 2>/dev/null | cut -f1
    else
        echo "0"
    fi
}

wipe_cache_dir() {
    local dir="$1"
    local label="$2"
    if [[ ! -d "$dir" ]]; then
        return 0
    fi
    local before
    before=$(size_of "$dir")
    info "Чищу $label ($dir) — было: $before"
    if rm -rf "$dir" 2>/dev/null && mkdir -p "$dir" 2>/dev/null; then
        local after
        after=$(size_of "$dir")
        ok "  → стало: $after"
    else
        warn "  → не удалось полностью очистить, пробую find…"
        find "$dir" -type f -delete 2>/dev/null || true
        find "$dir" -mindepth 1 -type d -empty -delete 2>/dev/null || true
        local after
        after=$(size_of "$dir")
        ok "  → стало: $after (после find)"
    fi
}

clean_cmd() {
    local cmd="$1"
    local label="$2"
    if command -v "$cmd" &>/dev/null; then
        info "Чищу $label через '$cmd'"
        eval "$cmd" 2>/dev/null && ok "  → готово" || warn "  → не удалось"
    fi
}

main() {
    echo "============================================"
    echo "  disk-hygiene — безопасная чистка кэшей"
    echo "============================================"

    show_df

    info "Кэши в \$HOME — если /home на другом разделе, df / почти не изменится."
    info "Для корня / нужны: sudo paccache … и journalctl …"
    echo ""

    local bytes_before
    bytes_before=$(size_bytes "$HOME/.cache" 2>/dev/null || echo 0)

    info "Размеры кэшей ДО чистки:"
    echo "--------------------------------------------"
    local targets=(
        "$HOME/.cache/yay"
        "$HOME/.cache/paru"
        "$HOME/.cache/go-build"
        "$HOME/.cache/pip"
        "$HOME/.cache/uv"
        "$HOME/.cache/pnpm"
        "$HOME/.cache/node-gyp"
        "$HOME/.cache/thumbnails"
        "$HOME/.cache/chromium"
        "$HOME/.cache/google-chrome"
        "$HOME/.cache/mozilla"
        "$HOME/.cache/electron"
        "$HOME/.cache/nvim"
        "$HOME/.cache/QGIS"
        "$HOME/.cache/mesa_shader_cache"
        "$HOME/.cache/mesa_shader_cache_db"
    )
    for t in "${targets[@]}"; do
        if [[ -d "$t" ]]; then
            printf "  %-50s %s\n" "$t" "$(size_of "$t")"
        fi
    done
    echo "--------------------------------------------"
    echo ""

    info "=== Чистка кэшей AUR-хелперов ==="
    wipe_cache_dir "$HOME/.cache/yay" "yay build cache"
    info "Чищу paru build cache — может занять минуту…"
    wipe_cache_dir "$HOME/.cache/paru" "paru build cache"

    info "=== Чистка go build cache ==="
    if command -v go &>/dev/null; then
        go clean -cache 2>/dev/null && ok "go clean -cache" || warn "go clean -cache failed"
    else
        wipe_cache_dir "$HOME/.cache/go-build" "go-build cache (no go binary)"
    fi

    info "=== Чистка pip cache ==="
    clean_cmd "pip cache purge" "pip cache"
    wipe_cache_dir "$HOME/.cache/pip" "pip cache dir"

    info "=== Чистка uv cache ==="
    if command -v uv &>/dev/null; then
        uv cache clean 2>/dev/null && ok "uv cache clean" || warn "uv cache clean failed"
    fi
    wipe_cache_dir "$HOME/.cache/uv" "uv cache dir"

    info "=== Чистка pnpm store ==="
    if command -v pnpm &>/dev/null; then
        pnpm store prune 2>/dev/null && ok "pnpm store prune" || warn "pnpm store prune failed"
    fi

    info "=== Чистка node-gyp cache ==="
    wipe_cache_dir "$HOME/.cache/node-gyp" "node-gyp cache"

    info "=== Чистка thumbnails ==="
    wipe_cache_dir "$HOME/.cache/thumbnails" "thumbnails"

    info "=== Чистка npm cache ==="
    if command -v npm &>/dev/null; then
        npm cache clean --force 2>/dev/null && ok "npm cache clean" || warn "npm cache clean failed"
    fi

    if [[ "$AGGRESSIVE" -eq 1 ]]; then
        echo ""
        info "=== [--aggressive] Чистка кэшей браузеров ==="
        wipe_cache_dir "$HOME/.cache/chromium" "chromium cache"
        wipe_cache_dir "$HOME/.cache/google-chrome" "google-chrome cache"
        wipe_cache_dir "$HOME/.cache/mozilla" "mozilla cache"
        wipe_cache_dir "$HOME/.cache/electron" "electron cache"
    else
        echo ""
        info "Кэши браузеров (chromium, chrome, mozilla, electron) — только отчёт."
        info "Для чистки добавь флаг: disk-hygiene --aggressive"
    fi

    echo ""
    show_df

    local bytes_after
    bytes_after=$(size_bytes "$HOME/.cache" 2>/dev/null || echo 0)
    local freed_bytes=0
    if [[ "$bytes_before" =~ ^[0-9]+$ ]] && [[ "$bytes_after" =~ ^[0-9]+$ ]]; then
        freed_bytes=$(( bytes_before - bytes_after ))
        if [[ "$freed_bytes" -lt 0 ]]; then
            freed_bytes=0
        fi
    fi
    local freed_mb=$(( freed_bytes / 1024 / 1024 ))
    ok "Освобождено в \$HOME/.cache: ~${freed_mb}M"

    echo ""
    echo "============================================"
    echo -e "  ${YELLOW}Требуют sudo — запусти вручную:${NC}"
    echo "============================================"
    echo ""
    echo "  # Оставить 2 версии каждого пакета в кэше pacman:"
    echo "  sudo paccache -rk2"
    echo ""
    echo "  # Удалить кэш удалённых пакетов:"
    echo "  sudo paccache -ruk0"
    echo ""
    echo "  # Журналы старше 7 дней:"
    echo "  sudo journalctl --vacuum-time=7d"
    echo ""
    echo "  # (опционально) Docker, если есть:"
    echo "  docker system prune -af --volumes"
    echo ""

    ok "disk-hygiene завершена."
}

main "$@"
