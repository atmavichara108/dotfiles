#!/usr/bin/env bash
set -uo pipefail

WALLDIR="${THEME_WALLDIR:-$HOME/wallpapers}"

main_menu() {
    printf '%s\n' \
        "🖼  Обои (слой wall)" \
        "🎲  Случайные обои (слой wall)" \
        "↻  Повторить последние (слой wall)" \
        "📁  Открыть папку обоев"
}

choose_wallpaper() {
    local chosen
    chosen="$(cd "$WALLDIR" && find . -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%P\n' 2>/dev/null | sort | rofi -dmenu -i -p "Обои" -no-custom)" || return 0
    [[ -z "$chosen" ]] && return 0
    theme-apply "$WALLDIR/$chosen"
}

choice="$(main_menu | rofi -dmenu -i -p "Theme hub" -no-custom)" || exit 0

case "$choice" in
    *"Обои (слой"*)  choose_wallpaper ;;
    *"Случайные"*)   theme-apply --random ;;
    *"Повторить"*)   theme-apply --last ;;
    *"Открыть"*)     xdg-open "$WALLDIR" 2>/dev/null & ;;
esac
