#!/usr/bin/env bash
set -uo pipefail

WALLDIR="${THEME_WALLDIR:-$HOME/wallpapers}"
STATE_DIR="$HOME/.local/state/theme-hub"
WAL_CACHE_DIR="$HOME/.cache/wal"

mkdir -p "$STATE_DIR" "$WAL_CACHE_DIR"

OPT_RANDOM=0
OPT_LAST=0
IMAGE_ARG=""
[[ "${THEME_UPDATE_LOCK:-0}" == "1" ]] && OPT_LOCK=1 || OPT_LOCK=0

seed_bar_json() {
    [[ -f "$STATE_DIR/bar.json" ]] && return
    printf '%s\n' '{"source":"cyber-solar-base","palette":["#0d1a1e","#e8dcc0","#0a1418","#d97253","#7fa063","#d4a24c","#3a8e8e","#56b5b5","#a86fa3","#b8c4b8"]}' > "$STATE_DIR/bar.json"
}
seed_bar_json

parse_args() {
    [[ "${1:-}" == "wall" ]] && shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --random)  OPT_RANDOM=1; shift ;;
            --last)    OPT_LAST=1; shift ;;
            *)         IMAGE_ARG="$1"; shift ;;
        esac
    done
}

pick_random() {
    find "$WALLDIR" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n 1
}

read_prev_wallpaper() {
    local wp=""
    [[ -f "$STATE_DIR/prev-wall" ]] && wp="$(tr -d '\r\n' < "$STATE_DIR/prev-wall")"
    [[ -z "$wp" && -f "$STATE_DIR/last-wall" ]] && wp="$(tr -d '\r\n' < "$STATE_DIR/last-wall")"
    if [[ -z "$wp" ]] && [[ -f "$STATE_DIR/wall.json" ]]; then
        wp="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['wallpaper'])" "$STATE_DIR/wall.json" 2>/dev/null)"
    fi
    printf '%s' "$wp"
}

resolve_image() {
    if (( OPT_RANDOM )); then pick_random; return; fi
    if [[ -n "$IMAGE_ARG" ]]; then printf '%s' "$IMAGE_ARG"; return; fi
    pick_random
}

extract_palette_json() {
    local colors_file="${1:-$WAL_CACHE_DIR/colors.json}"
    [[ ! -f "$colors_file" ]] && return 1
    python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
p=[d['colors'][f'color{i}'] for i in range(16)]
print(json.dumps({'bg':d['special']['background'],'fg':d['special']['foreground'],'palette':p}))
" "$colors_file" 2>/dev/null
}

run_wallust() {
    local image="$1" log="$STATE_DIR/wallust.log"
    timeout 30 wallust run "$image" >"$log" 2>&1
}

write_state() {
    local image="$1" palette_json="$2"
    [[ -f "$STATE_DIR/last-wall" ]] && mv "$STATE_DIR/last-wall" "$STATE_DIR/prev-wall"
    printf '%s' "$image" > "$STATE_DIR/last-wall"
    python3 - "$image" "$palette_json" "$STATE_DIR" <<'PYEOF'
import sys,json,os;from datetime import datetime
i,p,s=sys.argv[1],json.loads(sys.argv[2]),sys.argv[3]
d={"wallpaper":i,"engine":"wallust","timestamp":datetime.now().isoformat(),"palette":p["palette"],"background":p["bg"],"foreground":p["fg"]}
json.dump(d,open(os.path.join(s,"wall.json"),"w"),indent=2)
PYEOF
}

fast_last() {
    local wp
    wp="$(read_prev_wallpaper)"
    [[ -z "$wp" ]] || [[ ! -f "$wp" ]] && return 1
    [[ -f "$STATE_DIR/last-wall" ]] && cp "$STATE_DIR/last-wall" "$STATE_DIR/prev-wall"
    printf '%s' "$wp" > "$STATE_DIR/last-wall"
    feh --bg-fill "$wp"
    killall -q dunst
    dunst &
    notify-send "Тема [wall]" "$(basename "$wp")" -t 3000
    return 0
}

main() {
    parse_args "$@"

    if (( OPT_LAST )); then
        if fast_last; then exit 0; fi
        notify-send "theme-apply" "--last: нет валидных обоев" -u critical
        exit 1
    fi

    IMAGE="$(resolve_image)"
    if [[ -z "$IMAGE" ]]; then
        notify-send "theme-apply" "Нет обоев в $WALLDIR" -u critical; exit 1
    fi
    if [[ ! -f "$IMAGE" ]]; then
        notify-send "theme-apply" "Файл не найден: $IMAGE" -u critical; exit 1
    fi
    if ! command -v wallust &>/dev/null; then
        notify-send "theme-apply" "wallust не найден" -u critical; exit 1
    fi

    killall -q notify-send 2>/dev/null || true
    notify-send "theme-apply" "Применяю $(basename "$IMAGE")..." -t 2000

    local OPT_LOCK_CAPTURED=$OPT_LOCK
    local IMAGE_CAPTURED="$IMAGE"
    local STATE_DIR_CAPTURED="$STATE_DIR"
    local WAL_CACHE_DIR_CAPTURED="$WAL_CACHE_DIR"

    (
        if ! run_wallust "$IMAGE_CAPTURED"; then
            PALETTE_JSON=""
            if PALETTE_JSON="$(extract_palette_json)"; then
                write_state "$IMAGE_CAPTURED" "$PALETTE_JSON"
            else
                err=""
                [[ -f "$STATE_DIR_CAPTURED/wallust.log" ]] && err="$(head -1 "$STATE_DIR_CAPTURED/wallust.log" | cut -c1-100)"
                notify-send "theme-apply" "wallust: OOM (${err:-unknown})" -u critical
                exit 1
            fi
        else
            PALETTE_JSON=""
            if ! PALETTE_JSON="$(extract_palette_json)"; then
                notify-send "theme-apply" "colors.json пуст" -u critical
                exit 1
            fi
            write_state "$IMAGE_CAPTURED" "$PALETTE_JSON"
        fi

        feh --bg-fill "$IMAGE_CAPTURED"
        killall -q dunst
        dunst &

        if (( OPT_LOCK_CAPTURED )); then
            betterlockscreen -u "$IMAGE_CAPTURED" --display 1 &
        fi

        notify-send "Тема [wall]" "$(basename "$IMAGE_CAPTURED")" -t 3000
    ) &

    exit 0
}

main "$@"
