#!/usr/bin/env bash
set -uo pipefail

WALLDIR="${THEME_WALLDIR:-$HOME/wallpapers}"
STATE_DIR="$HOME/.local/state/theme-hub"
WAL_CACHE_DIR="$HOME/.cache/wal"
LOCK_FILE="$STATE_DIR/apply.lock"
PREPARE_TIMEOUT="${THEME_PREPARE_TIMEOUT:-60}"
WALLUST_TIMEOUT="${THEME_WALLUST_TIMEOUT:-30}"

mkdir -p "$STATE_DIR" "$WAL_CACHE_DIR"

OPT_RANDOM=0; OPT_LAST=0; IMAGE_ARG=""
[[ "${THEME_UPDATE_LOCK:-0}" == "1" ]] && OPT_LOCK=1 || OPT_LOCK=0

_notify() {
    ( timeout 2 notify-send "$@" 2>/dev/null ) &
}

seed_bar_json() {
    [[ -f "$STATE_DIR/bar.json" ]] && return
    printf '%s\n' '{"source":"cyber-solar-base","palette":["#0d1a1e","#e8dcc0","#0a1418","#d97253","#7fa063","#d4a24c","#3a8e8e","#56b5b5","#a86fa3","#b8c4b8"]}' > "$STATE_DIR/bar.json"
}
seed_bar_json

parse_args() {
    [[ "${1:-}" == "wall" ]] && shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --random)  OPT_RANDOM=1; shift ;;
            --last)    OPT_LAST=1; shift ;;
            *)         IMAGE_ARG="$1"; shift ;;
        esac
    done
}

pick_random() {
    find "$WALLDIR" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n 1
}

read_prev_wallpaper() {
    local wp=""
    [[ -f "$STATE_DIR/prev-wall" ]] && wp="$(tr -d '\r\n' < "$STATE_DIR/prev-wall")"
    [[ -z "$wp" && -f "$STATE_DIR/last-wall" ]] && wp="$(tr -d '\r\n' < "$STATE_DIR/last-wall")"
    [[ -z "$wp" && -f "$STATE_DIR/wall.json" ]] && wp="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['wallpaper'])" "$STATE_DIR/wall.json" 2>/dev/null)"
    printf '%s' "$wp"
}

resolve_image() {
    if (( OPT_RANDOM )); then pick_random; return; fi
    if [[ -n "$IMAGE_ARG" ]]; then printf '%s' "$IMAGE_ARG"; return; fi
    pick_random
}

validate_tools() {
    for tool in identify magick wallust; do
        command -v "$tool" &>/dev/null || {
            _notify "theme-apply" "$tool не найден" -u critical
            exit 1
        }
    done
}

extract_palette() {
    local colors_file="${1:-$WAL_CACHE_DIR/colors.json}"
    [[ ! -f "$colors_file" ]] && return 1
    python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
p=[d['colors'][f'color{i}'] for i in range(16)]
print(json.dumps({'bg':d['special']['background'],'fg':d['special']['foreground'],'palette':p}))
" "$colors_file" 2>/dev/null
}

prepare_image() {
    local image="$1" prepared_dir="$HOME/.cache/theme-hub/prepared"
    mkdir -p "$prepared_dir"
    local dims
    dims="$(identify -format "%wx%h" "$image" 2>/dev/null)" || { echo "$image"; return; }
    local w h area max_dim
    w="${dims%x*}"; h="${dims#*x}"; area=$((w * h)); max_dim=$((w > h ? w : h))
    if (( max_dim <= 8192 && area <= 104857600 )); then echo "$image"; return; fi
    local hash cache_file
    hash="$(stat -c '%n%s%Y' "$image" | md5sum | cut -c1-12)"
    cache_file="$prepared_dir/$hash.png"
    if [[ -f "$cache_file" ]]; then echo "$cache_file"; return; fi
    local prepare_exit=0
    timeout "$PREPARE_TIMEOUT" magick "$image" -resize "3840x2160>" "$cache_file" \
        2>>"$STATE_DIR/prepare.log" || prepare_exit=$?
    if [[ $prepare_exit -eq 0 ]]; then
        echo "$cache_file"
    elif [[ $prepare_exit -eq 124 ]]; then
        _notify "theme-apply" "Даунскейл timeout (${PREPARE_TIMEOUT}s)" -u critical
        return 1
    else
        local err
        err="$(head -1 "$STATE_DIR/prepare.log" 2>/dev/null | cut -c1-100)"
        _notify "theme-apply" "Даунскейл failed: ${err:-unknown}" -u critical
        return 1
    fi
}

get_image_hash() {
    local image="$1"
    stat -c '%n%s%Y' "$image" | md5sum | cut -c1-12
}

check_palette_cache() {
    local hash="$1" palette_cache_dir="$HOME/.cache/theme-hub/palettes"
    local palette_file="$palette_cache_dir/$hash.json"
    [[ -f "$palette_file" ]] || return 1
    local content
    content="$(cat "$palette_file")" || return 1
    if ! python3 -c "
import json,sys,re
d=json.loads(sys.argv[1])
required=['bg','fg','palette','wallpaper','alpha','cursor']
if not all(k in d for k in required): sys.exit(1)
if not isinstance(d.get('palette'),list) or len(d['palette'])!=16: sys.exit(1)
hex_re=re.compile(r'^#[0-9A-Fa-f]{6}$')
for k in ['bg','fg','cursor']:
    if not hex_re.match(str(d.get(k,''))): sys.exit(1)
for c in d['palette']:
    if not hex_re.match(str(c)): sys.exit(1)
if not isinstance(d.get('wallpaper'),str) or not d['wallpaper'].strip(): sys.exit(1)
" "$content" 2>/dev/null; then
        return 1
    fi
    echo "$content"
}

save_palette_cache() {
    local hash="$1" palette_json="$2" wallpaper="$3"
    local palette_cache_dir="$HOME/.cache/theme-hub/palettes"
    mkdir -p "$palette_cache_dir"
    python3 - "$hash" "$palette_json" "$wallpaper" "$palette_cache_dir" <<'PYEOF'
import json,sys,os
hash_val,palette_json,wallpaper,cache_dir=sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4]
p=json.loads(palette_json)
extended={
    "bg":p["bg"],
    "fg":p["fg"],
    "palette":p["palette"],
    "wallpaper":wallpaper,
    "alpha":"100",
    "cursor":p.get("cursor",p["fg"])
}
tmp=os.path.join(cache_dir,f".{hash_val}.tmp")
final=os.path.join(cache_dir,f"{hash_val}.json")
try:
    with open(tmp,"w") as f:
        json.dump(extended,f)
    os.replace(tmp,final)
except:
    if os.path.exists(tmp):
        os.remove(tmp)
    raise
PYEOF
}

restore_palette_cache() {
    local palette_json="$1"
    python3 - "$palette_json" "$WAL_CACHE_DIR" <<'PYEOF'
import json,sys,os
palette_json,wal_cache=sys.argv[1],sys.argv[2]
d=json.loads(palette_json)
wallpaper=d.get("wallpaper","")
alpha=d.get("alpha","100")
bg=d["bg"]
fg=d["fg"]
cursor=d.get("cursor",fg)
palette=d["palette"]

colors_json={
    "wallpaper":wallpaper,
    "alpha":alpha,
    "special":{"background":bg,"foreground":fg,"cursor":cursor},
    "colors":{f"color{i}":palette[i] for i in range(16)}
}

colors_json_path=os.path.join(wal_cache,"colors.json")
tmp_colors=colors_json_path+".tmp"
def lighten(hex_color,factor):
    hex_color=hex_color.lstrip('#')
    r,g,b=int(hex_color[0:2],16),int(hex_color[2:4],16),int(hex_color[4:6],16)
    r=min(255,int(r+(255-r)*factor))
    g=min(255,int(g+(255-g)*factor))
    b=min(255,int(b+(255-b)*factor))
    return f"#{r:02X}{g:02X}{b:02X}"

alacritty=f"""[colors.primary]
background = "{bg}"
foreground = "{fg}"

[colors.normal]
black = "{lighten(palette[0],0.4)}"
red = "{lighten(palette[1],0.4)}"
green = "{lighten(palette[2],0.4)}"
yellow = "{lighten(palette[3],0.4)}"
blue = "{lighten(palette[4],0.4)}"
magenta = "{lighten(palette[5],0.4)}"
cyan = "{lighten(palette[6],0.4)}"
white = "{lighten(palette[7],0.4)}"

[colors.bright]
black = "{lighten(palette[8],0.35)}"
red = "{lighten(palette[9],0.35)}"
green = "{lighten(palette[10],0.35)}"
yellow = "{lighten(palette[11],0.35)}"
blue = "{lighten(palette[12],0.35)}"
magenta = "{lighten(palette[13],0.35)}"
cyan = "{lighten(palette[14],0.35)}"
white = "{lighten(palette[15],0.35)}"
"""

alacritty_path=os.path.join(wal_cache,"colors-alacritty.toml")
tmp_alacritty=alacritty_path+".tmp"
try:
    with open(tmp_colors,"w") as f:
        json.dump(colors_json,f,indent=4)
    os.replace(tmp_colors,colors_json_path)
    with open(tmp_alacritty,"w") as f:
        f.write(alacritty)
    os.replace(tmp_alacritty,alacritty_path)
except:
    for tmp in [tmp_colors,tmp_alacritty]:
        if os.path.exists(tmp):
            os.remove(tmp)
    raise
PYEOF
}

update_state() {
    local image="$1" palette_json="$2"
    [[ -f "$STATE_DIR/last-wall" ]] && mv "$STATE_DIR/last-wall" "$STATE_DIR/prev-wall"
    printf '%s' "$image" > "$STATE_DIR/last-wall"
    python3 - "$image" "$palette_json" "$STATE_DIR" <<'PYEOF'
import sys,json,os;from datetime import datetime
i,p,s=sys.argv[1],json.loads(sys.argv[2]),sys.argv[3]
d={"wallpaper":i,"engine":"wallust","timestamp":datetime.now().isoformat(),"palette":p["palette"],"background":p["bg"],"foreground":p["fg"]}
json.dump(d,open(os.path.join(s,"wall.json"),"w"),indent=2)
PYEOF
}

read_palette_from_state() {
    [[ -f "$STATE_DIR/wall.json" ]] && python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
print(json.dumps({'bg':d.get('background',''),'fg':d.get('foreground',''),'palette':d.get('palette',[])}))
" "$STATE_DIR/wall.json" 2>/dev/null && return
    [[ -f "$STATE_DIR/bar.json" ]] && cat "$STATE_DIR/bar.json"
}

apply_wallpaper() {
    local image="$1" notify_msg="$2"
    timeout 5 feh --bg-fill "$image" 2>/dev/null || true
    killall -q dunst 2>/dev/null || true
    ( sleep 0.1; exec dunst 2>/dev/null ) &
    ( timeout 2 notify-send "Тема [wall]" "$notify_msg" -t 3000 2>/dev/null ) &
    if [[ "${OPT_LOCK:-0}" == "1" ]] && command -v betterlockscreen &>/dev/null; then
        betterlockscreen -u "$image" &
    fi
}

acquire_lock() {
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        if ! flock -w 3 9; then
            _notify "theme-apply" "Другой процесс уже применяет тему" -t 2000
            exit 1
        fi
    fi
}

release_lock() {
    flock -u 9 2>/dev/null || true
}

main() {
    parse_args "$@"
    acquire_lock
    trap release_lock EXIT

    if (( OPT_LAST )); then
        wp="$(read_prev_wallpaper)"
        if [[ -z "$wp" ]] || [[ ! -f "$wp" ]]; then
            _notify "theme-apply" "--last: нет валидных обоев" -u critical
            exit 1
        fi
        local last_hash
        last_hash="$(get_image_hash "$wp")"
        PALETTE_JSON="$(check_palette_cache "$last_hash")" || {
            _notify "theme-apply" "--last: палитра для этого wallpaper не найдена в кэше" -u critical
            exit 1
        }
        if ! restore_palette_cache "$PALETTE_JSON"; then
            _notify "theme-apply" "--last: не удалось восстановить consumers" -u critical
            exit 1
        fi
        if ! update_state "$wp" "$PALETTE_JSON"; then
            _notify "theme-apply" "--last: не удалось обновить состояние" -u critical
            exit 1
        fi
        apply_wallpaper "$wp" "$(basename "$wp")"
        exit 0
    fi

    validate_tools

    IMAGE="$(resolve_image)"
    if [[ -z "$IMAGE" ]] || [[ ! -f "$IMAGE" ]]; then
        _notify "theme-apply" "${IMAGE:+Файл не найден: }${IMAGE:-Нет обоев в $WALLDIR}" -u critical
        exit 1
    fi

    > "$STATE_DIR/wallust.log"; > "$STATE_DIR/prepare.log"
    _notify "theme-apply" "Применяю $(basename "$IMAGE")..." -t 2000
    ORIG_IMAGE="$IMAGE"
    IMAGE="$(prepare_image "$IMAGE")" || exit 1
    IMAGE_HASH="$(get_image_hash "$ORIG_IMAGE")"

    PALETTE_JSON="$(check_palette_cache "$IMAGE_HASH")" && {
        if ! restore_palette_cache "$PALETTE_JSON"; then
            _notify "theme-apply" "cache hit, но восстановление consumers не удалось" -u critical
            exit 1
        fi
        if ! update_state "$ORIG_IMAGE" "$PALETTE_JSON"; then
            _notify "theme-apply" "не удалось обновить состояние" -u critical
            exit 1
        fi
        apply_wallpaper "$IMAGE" "$(basename "$ORIG_IMAGE")"
        exit 0
    }

    local wallust_exit=0
    timeout "$WALLUST_TIMEOUT" wallust run "$IMAGE" >>"$STATE_DIR/wallust.log" 2>&1 || wallust_exit=$?

    if [[ $wallust_exit -eq 124 ]]; then
        _notify "theme-apply" "wallust timeout (${WALLUST_TIMEOUT}s)" -u critical
        exit 1
    elif [[ $wallust_exit -ne 0 ]]; then
        local err
        err="$(head -1 "$STATE_DIR/wallust.log" 2>/dev/null | cut -c1-100)"
        _notify "theme-apply" "wallust failed: ${err:-unknown}" -u critical
        exit 1
    fi

    if ! PALETTE_JSON="$(extract_palette)"; then
        _notify "theme-apply" "wallust output invalid" -u critical
        exit 1
    fi

    if ! save_palette_cache "$IMAGE_HASH" "$PALETTE_JSON" "$ORIG_IMAGE"; then
        _notify "theme-apply" "не удалось сохранить палитру в кэш" -u critical
        exit 1
    fi
    if ! update_state "$ORIG_IMAGE" "$PALETTE_JSON"; then
        _notify "theme-apply" "не удалось обновить состояние" -u critical
        exit 1
    fi
    apply_wallpaper "$IMAGE" "$(basename "$ORIG_IMAGE")"
}

main "$@"
