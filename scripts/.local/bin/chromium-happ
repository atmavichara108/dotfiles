#!/bin/bash
# chromium-happ — Chromium через HAPP proxy (приоритет владельца 2026-11-05).
#
# Раньше wrapper читал proxyctl mode и при mode=tor/auto-fallback уводил
# Chromium в Tor. Tor остаётся ТОЛЬКО для отдельного chromium-tor.
# Здесь иначе: Happ — единственный путь; порт 10808 недоступен → отказ,
# а не тихая подмена на Tor (иначе «прокси в Chromium слетел» повторяется).
set -euo pipefail

# Chromium НЕ поддерживает socks5h; socks5 через Happ уже даёт рабочий маршрут
# (инцидент 2026-11-05: socks5h -> ERR_NO_SUPPORTED_PROXIES).
HAPP_PROXY="socks5://127.0.0.1:10808"

if ! (echo > /dev/tcp/127.0.0.1/10808) 2>/dev/null; then
    echo "chromium-happ: HAPP proxy недоступен на 127.0.0.1:10808 — отказ, Tor-fallback отключён" >&2
    exit 75
fi

exec chromium --proxy-server="$HAPP_PROXY" "$@"
