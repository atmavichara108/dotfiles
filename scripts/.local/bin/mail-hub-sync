#!/usr/bin/env python3
"""mail-hub-sync — синхронизация IMAP → Maildir (обёртка mbsync, A4/A6).

Клиент работает с локальным Maildir (хендофф A4): сеть — забота этого
синхронизатора, не ядра. Идемпотентность — на стороне mbsync (UID-слой);
Message-ID-слой — в тредах клиента (A6).

Расшифровка: Maildir — формат локального почтового ящика (файл = письмо);
mbsync — утилита синхронизации IMAP↔Maildir; «new» — непрочитанные.
"""
import pathlib
import subprocess
import sys


def main() -> int:
    channel = sys.argv[1] if len(sys.argv) > 1 else "re-search-wiki"
    r = subprocess.run(["mbsync", channel], capture_output=True, text=True)
    if r.stdout:
        sys.stdout.write(r.stdout)
    if r.stderr:
        sys.stderr.write(r.stderr)
    if r.returncode != 0:
        return r.returncode
    inbox = pathlib.Path.home() / "Mail/re-search.wiki/INBOX/new"
    if inbox.exists():
        n = len(list(inbox.glob("*")))
        print(f"sync OK: {n} непрочитанных в INBOX")
    else:
        print("sync OK: Maildir появится после первого прогона (или заполни ~/.mbsyncrc)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
