#!/usr/bin/env bash
# opencode-reload — ПОЛНАЯ перезагрузка backend'а OpenCode v2 (INC-15, 2026-10-17).
#
# Проблема: плагины грузятся в ПАМЯТЬ при старте процесса opencode и
# не hot-reload. Рестарт TUI-окна не помогает, если процесс-демон жив —
# живёт в памяти старый код (например, plugin decision-queue-hook).
# Старая версия скрипта убивала только `opencode serve --service` —
# pid'ов "opencode serve" у встроенных (paused embedded) серверов нет,
# и иногда она не убивала ничего.
#
# Что убиваем (текущая топология OpenCode):
#   - `opencode`            — TUI терминала со встроенным сервером;
#   - `opencode -s ses_*`   — TUI конкретной сессии (то же самое + serve at child);
#   - `opencode serve*`     — выделенный сервер (в т.ч. harness-owned).
#
# Что НЕ убиваем:
#   - `opencode run ...` — короткая разовая задача (letter.sh/one-shots) —
#     они сами умирают; в путь не попадают.
#
# Сессии персистентны в БД opencode (session_v2 + messages + plugin-free),
# поэтому перезапуск процессов безопасен: новый TUI / новый `letter.sh`
# или /resume вернут сессию с полным контекстом. Параллельные TUI окна
# отваливаются — их надо открыть заново.
#
# Безопасность: просто SIGTERM по списку PID, без оперативных вызовов.
# Ничего не трогает права/конфиги.
#
# Restore (BF-20261018-02): mod+o возвращает пользователя в то же положение —
# до убийства снимаем, в какой tmux-панели какой opencode открыт (сессия из
# args `-s ses_*`, для plain — последняя просмотренная сессия этого cwd по БД,
# колонка time_viewed; это ровно та, что открыта в TUI прямо сейчас). После
# перезагрузки в каждую панель отправляется её команда запуска через
# `tmux send-keys` — панель живёт (shell остаётся shell'ом), фокус/вкладки
# tmux не сдвигаются, поведение вкладок не меняется. TUI вне tmux
# восстановить автоматически нельзя — только уведомление.
set -u

DRYRUN=0
[[ "${1:-}" == "--dry-run" ]] && DRYRUN=1

killed=0
skipped=0

# --- Restore: снимок tmux-панелей с живым opencode (до убийства) ---
# ВАЖНО (BF-20261018-02): вкладки внутри одного TUI opencode восстанавливает
# САМ — штатно из ~/.local/state/opencode/latest/tui/tabs.json (map cwd →
# список sessionID-вкладок). от нас нужно ровно одно: перезапустить opencode
# в той же tmux-панели и с тем же запускающим аргументом (-s ses_* или plain).
# Играть в sqlite/time_viewed не нужно — только мешает.
declare -a SNAPS=()   # строки «pane_id|запуск»
TMUX_OK=0
if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    TMUX_OK=1
    declare -A PANE_BY_PID=()
    while IFS='|' read -r pane pid dead; do
        [[ "$dead" == "0" ]] && PANE_BY_PID["$pid"]="$pane"
    done < <(tmux list-panes -a -F '#{pane_id}|#{pane_pid}|#{pane_dead}' 2>/dev/null)

    while IFS= read -r tp; do
        targs=$(ps -o args= -p "$tp" 2>/dev/null) || targs=""
        [[ "$targs" == *"opencode run "* ]] && continue
        # ищем tmux-панель-предка TUI-процесса (вверх до pane_pid)
        pane=""
        par="$tp"
        for _ in 1 2 3 4 5 6; do
            par=$(ps -o ppid= -p "$par" 2>/dev/null | tr -d ' ')
            [[ -z "$par" || "$par" == "1" ]] && break
            p="${PANE_BY_PID[$par]:-}"
            if [[ -n "$p" ]]; then pane="$p"; break; fi
        done
        [[ -z "$pane" ]] && continue   # opencode вне tmux — авто-восстановления нет
        if [[ "$targs" == *"opencode -s"* ]]; then
            sess=$(grep -oE 'ses_[A-Za-z0-9]+' <<< "$targs" | head -1)
            [[ -n "$sess" ]] && tstart="opencode -s ${sess}" || tstart="opencode"
        else
            tstart="opencode"   # plain: вкладки вернёт tabs.json по cwd
        fi
        SNAPS+=("${pane}|${tstart}")
    done < <(pgrep -x opencode 2>/dev/null)
fi

if (( DRYRUN )); then
    echo "DRY-RUN: план восстановления (панель|запуск):"
    if [[ ${#SNAPS[@]} -eq 0 ]]; then echo "  (нет opencode в tmux-панелях)"; fi
    for s in "${SNAPS[@]}"; do printf '  %s\n' "$s"; done
    echo "DRY-RUN: kill и восстановление пропущены"
    exit 0
fi

# Уникальный список PID opencode-процессов (TUI/embedded/serve).
mapfile -t pids < <(pgrep -x opencode 2>/dev/null; pgrep -f 'opencode (serve|-s ses_)' 2>/dev/null)
pids=$(printf '%s\n' "${pids[@]}" 2>/dev/null | sort -u)

if [[ -z "$pids" ]]; then
    echo "opencode processes: none running"
    command -v notify-send >/dev/null 2>&1 && notify-send "opencode" "reload: процессов opencode нет, нечего перезагружать"
    exit 0
fi

for pid in $pids; do
    args=$(ps -o args= -p "$pid" 2>/dev/null) || args=""
    base=${args%% *}
    base=${base##*/}
    # только процессы, исполняемый файл которых opencode (TUI/serve/run);
    # их дети (bun-задачи, shim, letter) убиваются сами или ниже по дереву
    [[ "$base" == "opencode" ]] || continue
    # НЕ убиваем разовые задачи `opencode run ...` (letter.sh/one-shots) —
    # они умирают сами и чаще всего держат важного письмо-агента.
    case "$args" in
        *"opencode run "*) continue ;;
        # serve был пропущен при первом прогоне: у выделенного сервера путь
        # полный (`~/.opencode/bin/opencode serve --service`), старый case-фильтр
        # `opencode*` его отсекал — инцидент BF-20261018 (image-read не встав).
        *"opencode serve"*) ;;
        *"opencode -s ses_"*) ;;  # TUI конкретной сессии
        opencode) ;;              # plain TUI
        *) continue ;;
    esac
    if kill "$pid" 2>/dev/null; then
        echo "killed: pid $pid  ($args)"
        killed=$((killed + 1))
    else
        echo "cannot kill: pid $pid" >&2
        skipped=$((skipped + 1))
    fi
done

sleep 0.3
# подчистить детей, отсиротевших от убитых TUI-процессов (serve --service)
for cpid in $(pgrep -f "opencode serve" 2>/dev/null); do
    ppid=$(ps -o ppid= -p "$cpid" | tr -d ' ')
    [[ -d "/proc/$ppid" ]] || { kill "$cpid" 2>/dev/null && { echo "killed orphaned serve: pid $cpid"; killed=$((killed + 1)); }; }
done

# --- Restore: каждой tmux-панели — её opencode и её сессия ---
if [[ "$TMUX_OK" == "1" && ${#SNAPS[@]} -gt 0 ]]; then
    sleep 0.7   # shell'ы панелей успели вернуться в prompt
    for snap in "${SNAPS[@]}"; do
        IFS='|' read -r pane cmd <<< "$snap"
        [[ -z "$pane" ]] && continue
        if tmux send-keys -t "$pane" -l "$cmd" 2>/dev/null && tmux send-keys -t "$pane" Enter 2>/dev/null; then
            echo "restore: pane ${pane} -> ${cmd}"
        else
            echo "restore: не удалось вписать команду в ${pane}" >&2
        fi
    done
fi

msg="opencode перезагружен (killed $killed, skipped $skipped); tmux-вкладки возвращаются сами; TUI вне tmux — открыть вручную"
echo "$msg"
command -v notify-send >/dev/null 2>&1 && notify-send "opencode" "$msg"
