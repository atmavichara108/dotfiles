# Игнорировать приватные данные
**/secrets.yaml
**/*secret*
**/secrets/
**/.env
**/.env.local
**/tokens

# Игнорировать кеши
**/.cache/
**/cache/
__pycache__/
*.pyc

# Игнорировать плагины (если используешь plugin manager)
**/nvim/plugin/
**/zsh/plugins/

# Логи
*.log
qtile/.config/qtile/wallpapers/

# Обои и медиа
**/wallpapers/
**/backgrounds/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.mp4
*.mkv

# Большие файлы
*.iso
*.tar.gz
*.zip

# Temporaries
*.swp
*.swo
*.swn
*~
.DS_Store
.directory

# Compiled
*.o
*.so
*.dylib
*.dll

# Archives
*.iso
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# IDE
.vscode/
.idea/
*.sublime-*

# System
Thumbs.db
Desktop.ini

# Backup files
*.backup
*.bak
*.old

# Oh-My-Zsh — не версионировать сам фреймворк
zsh/.oh-my-zsh/*
!zsh/.oh-my-zsh/custom/

# Игнорировать example плагин
zsh/.oh-my-zsh/custom/plugins/example/

# Игнорировать сторонние плагины (устанавливаются отдельно)
zsh/.oh-my-zsh/custom/plugins/zsh-*
zsh/.oh-my-zsh/custom/themes/powerlevel10k/

x11/.fehbg

# CopyQ runtime files
copyq/.config/copyq/*.lock
copyq/.config/copyq/*.dat
copyq/.config/copyq/.copyq_s
copyq/.config/copyq/copyq_geometry.ini

# TheFuck cache
thefuck/.config/thefuck/__pycache__/

# TaskVanguard state
task-tools/.config/taskvanguard/state.json

# Nitrogen runtime
nitrogen/.config/nitrogen/bg-saved.cfg

# Proxyctl runtime
proxyctl/.config/proxyctl/mode

# Calcurse data
calcurse/.config/calcurse/apts
calcurse/.config/calcurse/todo
calcurse/.config/calcurse/notes/

scripts/.local/bin/py.test
scripts/.local/bin/pytest

# OpenCode global config
opencode-global/.config/opencode/node_modules/
opencode-global/.config/opencode/package-lock.json
opencode-global/.config/opencode/bun.lock
