#!/bin/bash
# Dotfiles pre-commit: гигиена параллельной работы агентов (tree-hygiene).
# Установка: ln -sf ../../githooks/pre-commit .git/hooks/pre-commit
#
# Гейты:
#   1. Branch gate — коммит напрямую в main/master запрещён (кроме merge
#      и явного ALLOW_MAIN=1). В main — только merge.
#   2. Conflict-marker gate —<<<<<<< / ======= / >>>>>>> в staged-файлах.
#   3. Zone-mix gate — staged-файлы из разных тематических зон в одном
#      коммите запрещены: один коммит = один сюжет. Обход: MIXED_OK=1
#      (осознанный интеграционный коммит, объясни причину в сообщении).
#   4. Claim gate — staged не трогает scope живой чужой сессии (handshake
#      `.opencode/memory/session-reports/active/*.md`, heartbeat свежее 24ч).
#      Обход: CLAIM_OK=1 (осознанно).
#
# Зоны (порядок важен: первый матч побеждает):
#   promo-provider | pipboy | opencode | specs-docs | sysconfig | docs | misc

set -u

die() { echo "❌ $*" >&2; exit 1; }

git_branch() { git symbolic-ref --short -q HEAD 2>/dev/null || echo "(detached)"; }
is_merge()   { test -f "$(git rev-parse --git-dir)/MERGE_HEAD"; }

# --- Гейт 1: коммитить только в task/*-ветку (кроме merge/release) -----------
# Канон tree-hygiene: одна тематическая задача = одна ветка task/<slug>.
# Прямой коммит в main/master и в ветки вне task/* запрещён.
# Исключения: merge (MERGE_HEAD), осознанный release (ALLOW_MAIN=1).
if is_merge || [ "${ALLOW_MAIN:-0}" = "1" ]; then
  : # merge/release — разрешено
else
  br=$(git_branch)
  case "$br" in
    main|master)
      die "Коммит напрямую в '$br' запрещён. Работай в task/<slug>-ветке; в main — только merge (или ALLOW_MAIN=1 для осознанного release)."
      ;;
    task/*)
      : # штатная рабочая ветка
      ;;
    *)
      die "Коммит в ветку '$br' запрещён: канон — task/<slug> (один сюжет = одна ветка). Создай task-ветку через /branch или git switch -c task/<slug>; исключения — merge и ALLOW_MAIN=1."
      ;;
  esac
fi

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0

# --- Гейт 2: conflict-маркеры в staged ---------------------------------------
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.woff*|*.ttf|*.zip|*.7z|*.pdf) continue ;;
  esac
  if git show ":$f" 2>/dev/null | grep -qE '^(<{7,8}|={7}$|>{7,8}) '; then
    die "Conflict-маркеры в staged-файле: $f"
  fi
done <<< "$staged"

# --- Гейт 3: один коммит = одна зона -----------------------------------------
zone_of() {
  case "$1" in
    scripts/*|docs/specs/promo-provider*)      echo promo-provider ;;
    qtile/*|rofi/*|docs/specs/pipboy*)         echo pipboy ;;
    .opencode/*|opencode-global/*|opencode.json|opencode.jsonc|AGENTS.md|.gitignore|githooks/*) echo opencode ;;
    docs/specs/*|docs/decisions.md)            echo specs-docs ;;
    environment.d/*|git/*|lazygit/*|nvim/*|flameshot/*|zsh/*|picom/*|x11/*|systemd/*|screenlayout/*|dunst/*|tmux/*|alacritty/*|btop/*|bat/*|htop/*|neofetch/*|ranger/*|taskwarrior/*|wal/*|weathr/*|xdg/*) echo sysconfig ;;
    docs/*|README*|*.md)                       echo docs ;;
    *)                                         echo misc ;;
  esac
}

zones=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  z=$(zone_of "$f")
  case " $zones " in *" $z "*) ;; *) zones="$zones $z" ;; esac
done <<< "$staged"

n=$(echo $zones | wc -w)
if [ "$n" -gt 1 ] && [ "${MIXED_OK:-0}" != "1" ]; then
  echo "❌ Один коммит = один сюжет. Staged затрагивает $n зоны:$zones" >&2
  echo "   Разбей на отдельные коммиты по зонам или подтверди интеграционный: MIXED_OK=1 git commit ..." >&2
  exit 1
fi

# --- Гейт 4: staged не трогает scope живой чужой сессии ----------------------
# Единая истина обоих SDK: handshake `.opencode/memory/session-reports/active/*.md`
# (поля Ветка/Scope/Heartbeat). Чужая живая заявка (heartbeat свежее 24ч)
# + staged под её scope = стоп с указанием владельца. Своя ветка — всегда можно.
# Обход: CLAIM_OK=1 (осознанно, как MIXED_OK). Нет каталога заявок — пропускаем.
if [ "${CLAIM_OK:-0}" != "1" ]; then
  _root=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
  _br=$(git_branch)
  _hsdir="$_root/.opencode/memory/session-reports/active"
  if [ -d "$_hsdir" ]; then
    _today=$(date +%F)
    for _f in "$_hsdir"/*.md; do
      [ -f "$_f" ] || continue
      case "$_f" in */_template.md) continue ;; esac
      _hb=$(grep -m1 -E '^\s*-\s*\*\*Ветка:\*\*' "$_f" | sed 's/^[^:]*: *\** *//')
      [ -z "$_hb" ] && continue
      # своя ветка — не чужая
      [ "$_hb" = "$_br" ] && continue
      _hbdate=$(grep -m1 -E '^\s*-\s*\*\*Heartbeat:\*\*' "$_f" | sed 's/^[^:]*: *\** *//' | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -n1)
      _fresh=0
      if [ -n "$_hbdate" ]; then
        _hbsec=$(date -d "$_hbdate" +%s 2>/dev/null || echo 0)
        _todaysec=$(date -d "$_today" +%s 2>/dev/null || echo 0)
        # shellcheck disable=SC2004
        if [ "$_hbsec" -gt 0 ] && (( _todaysec - _hbsec < 86400 )); then _fresh=1; fi
      fi
      [ "$_fresh" = "1" ] || continue
      _scope=$(grep -m1 -E '^\s*-\s*\*\*Scope' "$_f" | sed 's/^[^:]*: *\** *//')
      [ -z "$_scope" ] && continue
      _hit=""
      while IFS= read -r _sp; do
        [ -z "$_sp" ] && continue
        # токены-пути: содержат '/' (префикс) — сверяем staged
        case "$_sp" in *"/"*)
          _tok=$(echo "$_sp" | sed 's/^ *//;s/ *$//;s|/$||')
          [ -z "$_tok" ] && continue
          while IFS= read -r _st; do
            [ -z "$_st" ] && continue
            case "$_st" in "$_tok"|"$_tok"/*) _hit="$_hit $_st" ;; esac
          done <<< "$staged"
          ;;
        esac
      done <<< "$(echo "$_scope" | tr ',;' '\n\n' | tr ' ' '\n')"
      if [ -n "$_hit" ]; then
        echo "❌ Staged трогает scope живой чужой сессии: $(basename "$_f") (ветка $_hb):$_hit" >&2
        echo "   Убери эти файлы из индекса или договорись с владельцем. Обход: CLAIM_OK=1 git commit ..." >&2
        exit 1
      fi
    done
  fi
fi

echo "✅ tree-hygiene: ветка/маркеры/зоны в порядке"
exit 0
